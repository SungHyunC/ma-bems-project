# MA-BEMS LLM gateway (read by server/mabems_server.py; never served to the browser)
LLM_POLICY=local_first
LLM_LOCAL_BASE_URL=http://127.0.0.1:11434
LLM_LOCAL_MODEL=qwen3-8b-local
LLM_LOCAL_KEEP_ALIVE=30m
LLM_LOCAL_FIRST_TOKEN_SECONDS=25
LLM_API_MODEL=claude-opus-5-5
LLM_API_EFFORT=low
LLM_API_MAX_CALLS_PER_HOUR=60
ANTHROPIC_API_KEY=

# public API (deploy/start-public.ps1 opens a Cloudflare tunnel to this port; 127.0.0.1 only)
MABEMS_PUBLIC_PORT=5179
MABEMS_SITE_URL=https://sunghyunc.github.io/ma-bems/
MABEMS_ALLOWED_ORIGINS=https://sunghyunc.github.io
MABEMS_KEY_RATE_PER_MIN=10
MABEMS_KEY_DAILY_CAP=300
MABEMS_MAX_INFLIGHT=2
# access keys: name=key pairs, made with  python server\mabems_server.py --new-key NAME [--admin]
# user keys = local model only, admin keys = local model + Claude
MABEMS_USER_KEYS=
MABEMS_ADMIN_KEYS=
